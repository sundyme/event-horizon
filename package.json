{
  "name": "event-horizon",
  "version": "1.0.0",
  "private": true,
  "description": "视界 EVENT HORIZON — a real-time, physically ray-traced fall into a black hole (WebGL2), plus the offline film pipeline.",
  "type": "module",
  "scripts": {
    "build": "sh build.sh",
    "serve": "node tools/server.mjs 5310",
    "stills": "node tools/still.mjs out/stills 960 402 1 12 22 30 42 55 59.5",
    "render:film": "node tools/render.mjs out/film.mp4 --spp 6 --step 0.6",
    "render:audio": "node tools/audio.mjs out/horizon.wav"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "license": "MIT"
}
